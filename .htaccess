# Fichier .htaccess pour FirstAudit.ma
# À placer à la racine de votre site

# Activer le module de réécriture
RewriteEngine On
RewriteBase /

# ========================================
# REDIRECTIONS 301 : .html vers sans .html
# ========================================
# Ceci corrige le problème des 14 pages "Sans objet"

# Rediriger toutes les URLs .html vers sans .html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)\.html$ /$1 [R=301,L]

# ========================================
# PAGES SPÉCIFIQUES (au cas où)
# ========================================

# Articles
Redirect 301 /article-cgi-2026.html https://firstaudit.ma/article-cgi-2026
Redirect 301 /article-creation-entreprise.html https://firstaudit.ma/article-creation-entreprise
Redirect 301 /article-creations-entreprises-2025.html https://firstaudit.ma/article-creations-entreprises-2025
Redirect 301 /article-digitalisation-comptable.html https://firstaudit.ma/article-digitalisation-comptable
Redirect 301 /article-dispositif-tpme.html https://firstaudit.ma/article-dispositif-tpme
Redirect 301 /article-loi-finances-2026.html https://firstaudit.ma/article-loi-finances-2026
Redirect 301 /article-notification-electronique-2026.html https://firstaudit.ma/article-notification-electronique-2026
Redirect 301 /article-recettes-fiscales-2025.html https://firstaudit.ma/article-recettes-fiscales-2025

# Pages outils
Redirect 301 /articles.html https://firstaudit.ma/articles
Redirect 301 /calculateur-salaire-net.html https://firstaudit.ma/calculateur-salaire-net
Redirect 301 /calendrier-fiscal.html https://firstaudit.ma/calendrier-fiscal
Redirect 301 /glossaire.html https://firstaudit.ma/glossaire
Redirect 301 /simulateurs.html https://firstaudit.ma/simulateurs

# ========================================
# CONTENU DUPLIQUÉ - Index
# ========================================
# Rediriger /index vers /
Redirect 301 /index https://firstaudit.ma/
Redirect 301 /index.html https://firstaudit.ma/

# ========================================
# SÉCURITÉ
# ========================================
# Protéger les fichiers sensibles
<Files .htaccess>
Order allow,deny
Deny from all
</Files>

# ========================================
# PERFORMANCE
# ========================================
# Activer la compression GZIP
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Cache des fichiers statiques
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
